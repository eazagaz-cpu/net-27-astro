/*
  # script-src includes *.sortallav.com for the ProfitON popunder. The tag is
  # served from a per-zone subdomain (wk. today) and these networks rotate it,
  # so pinning the exact host would break the ad on their next change — and a
  # CSP-blocked ad tag is invisible: the HTML has it, the vendor answers 200,
  # and the browser silently refuses to run it. `npm run validate:csp` fails the
  # build if any script the site loads is not permitted here.
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com https://push-sdk.com https://pagead2.googlesyndication.com https://tpc.googlesyndication.com https://googleads.g.doubleclick.net https://www.googletagservices.com https://adservice.google.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://wk.sortallav.com https://*.sortallav.com; connect-src 'self' https: wss:; frame-src https:; media-src 'self' blob: https:; worker-src 'self' blob:; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fallbacks/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/og-image.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/og-image.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=86400

/robots.txt
  Content-Type: text/plain
  Cache-Control: no-cache

/sitemap-index.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: no-cache

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: no-cache

/sitemap-0.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: no-cache

# These URLs stay crawlable so search engines can see noindex and remove old
# query variants from their indexes.
/player/
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store, max-age=0
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), unload=()

/player/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store, max-age=0
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), unload=()

/watchlist/
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store, max-age=0

/watchlist/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store, max-age=0

/detail/
  X-Robots-Tag: noindex, follow
  Cache-Control: private, no-store, max-age=0

/detail/*
  X-Robots-Tag: noindex, follow
  Cache-Control: private, no-store, max-age=0

/llms.txt
  Cache-Control: public, max-age=86400

# The search index is fetched the first time a visitor opens search. It is
# rebuilt on every deploy, so it can be cached hard and revalidated in the
# background rather than downloaded again each session.
/search-index.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# AdSense reads ads.txt as plain text and re-crawls it periodically, so it must
# not be served as anything else or held at the edge.
/ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

# Yandex Webmaster site verification. Left uncached so Yandex re-checks read a
# live response rather than an edge copy.
/yandex_c9591467b7b65148.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache

# RollerAds ownership verification — must stay reachable as plain text and must
# not be cached, or the verifier can read a stale/missing response.
/3006186.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache
  X-Robots-Tag: noindex

# RollerAds push service worker. A service worker runs under the CSP delivered
# with its own script response, and the site-wide `script-src 'self'` above
# would block its importScripts() call to push-sdk.com — so this path ships a
# narrower CSP that permits exactly that origin.
/3055833.sw.js
  Content-Type: text/javascript; charset=utf-8
  Content-Security-Policy: default-src 'self'; script-src 'self' https://push-sdk.com; connect-src 'self' https:; img-src 'self' data: https:
  Cache-Control: no-cache
  X-Robots-Tag: noindex

/watch/*
  Referrer-Policy: no-referrer-when-downgrade
