/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; connect-src 'self' https: wss:; frame-src https:; media-src 'self' blob: https:; worker-src 'self' blob:; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fallbacks/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/og-image.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/og-image.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=86400

/robots.txt
  Content-Type: text/plain
  Cache-Control: public, max-age=86400

/sitemap-index.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: no-cache

/sitemap-0.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: no-cache

# These URLs stay crawlable so search engines can see noindex and remove old
# query variants from their indexes.
/player/
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store, max-age=0
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), unload=()

/player/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store, max-age=0
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), unload=()

/watchlist/
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store, max-age=0

/watchlist/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store, max-age=0

/llms.txt
  Cache-Control: public, max-age=86400

/watch/*
  Referrer-Policy: no-referrer-when-downgrade
