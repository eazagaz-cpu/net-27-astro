/*
  # ─── Security Headers ────────────────────────────────────────────────────────
  # Applied to every response. Worker-generated responses get these through the
  # _headers mechanism on Cloudflare Pages; Worker code adds them separately for
  # on-demand routes.
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https://image.tmdb.org https://images.justwatch.com https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.google-analytics.com https://static.cloudflareinsights.com https://pagead2.googlesyndication.com https://tpc.googlesyndication.com https://googleads.g.doubleclick.net https://adservice.google.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google; connect-src 'self' https://api.themoviedb.org https://www.googletagmanager.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://stats.g.doubleclick.net https://pagead2.googlesyndication.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; media-src 'self' blob:; worker-src 'self' blob:; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()
  X-Permitted-Cross-Domain-Policies: none
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: cross-origin


# ─── Immutable static assets ─────────────────────────────────────────────────
# Astro fingerprints these filenames; they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fallbacks/*
  Cache-Control: public, max-age=31536000, immutable


# ─── Images ─────────────────────────────────────────────────────────────────
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/og-image.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/og-image.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=86400


# ─── SEO / crawl-critical files ──────────────────────────────────────────────
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

/sitemap-index.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/sitemap-0.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *


# ─── noindex / private routes ────────────────────────────────────────────────
# These URLs stay crawlable so search engines can see noindex and remove old
# query variants from their indexes.
/player/
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store, max-age=0
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()

/player/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store, max-age=0
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()

/watchlist/
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store, max-age=0

/watchlist/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store, max-age=0

/detail/
  X-Robots-Tag: noindex, follow
  Cache-Control: private, no-store, max-age=0

/detail/*
  X-Robots-Tag: noindex, follow
  Cache-Control: private, no-store, max-age=0


# ─── LLMs.txt ────────────────────────────────────────────────────────────────
/llms.txt
  Cache-Control: public, max-age=86400


# ─── Search index ─────────────────────────────────────────────────────────────
# Rebuilt on every deploy; cache with background revalidation.
/search-index.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400


# ─── AdSense ads.txt ─────────────────────────────────────────────────────────
/ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache


# ─── Webmaster verifications ──────────────────────────────────────────────────
/yandex_c9591467b7b65148.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache


# ─── IndexNow key ─────────────────────────────────────────────────────────────
/e9d6b5a3c2f1e8d7b4a0c5f2e1d8b3a6.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache, no-store
  Access-Control-Allow-Origin: *


# ─── Service Workers ──────────────────────────────────────────────────────────
# Service worker must never be edge-cached — browsers check it every 24h and
# a stale SW means users never receive updates.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/firebase-messaging-sw.js
  Cache-Control: no-cache, no-store, must-revalidate


# ─── PWA icons ───────────────────────────────────────────────────────────────
/icons/*
  Cache-Control: public, max-age=2592000

/manifest.json
  Cache-Control: no-cache
