---
/**
 * AboutPage.astro — the about page in any locale.
 *
 * Keeps its own layout rather than going through LegalPage: the hero, the
 * three feature cards and the CTA are not prose sections. Copy comes from
 * src/i18n/static; the icon paths stay here because they are presentation.
 */
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import SEOHead from '../SEOHead.astro';
import Schema from '../Schema.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { breadcrumbSchema, organizationSchema } from '../../lib/schema';
import { SITE_URL } from '../../lib/seo';
import { SITE_NAME } from '../../lib/constants';
import { loadTranslations, t } from '../../i18n';
import { getLocalizedPath } from '../../i18n/utils';
import { getStaticDocs } from '../../i18n/static';
import type { Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = await loadTranslations(lang);
const L = (path: string) => getLocalizedPath(path, lang);

const doc = getStaticDocs(lang).about;
const canonical = `${SITE_URL}${L('/about/')}`;

const breadcrumbs = [
  { label: t(tr, 'nav.home'), href: L('/') },
  { label: doc.breadcrumb, href: L('/about/') },
];

/** Icon per feature card, in the order the copy lists them. */
const FEATURE_ICONS = [
  'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2m-2 4h.01M12 12h.01M8 12h.01M12 16h.01M8 16h.01M16 12h.01M16 16h.01M7 20h10a2 2 0 002-2V8a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z',
];

// The brand name keeps its gradient treatment and stays untranslated, but each
// language puts it where its grammar wants it.
const [h1Before, h1After] = (() => {
  const at = doc.h1.indexOf('{name}');
  if (at === -1) return [doc.h1, ''];
  return [doc.h1.slice(0, at), doc.h1.slice(at + '{name}'.length)];
})();
---

<SEOHead
  slot="head"
  title={doc.seoTitle}
  description={doc.seoDescription}
  canonical={canonical}
  localized={true}
/>
<Schema slot="head" schema={[breadcrumbSchema(breadcrumbs), organizationSchema()]} />

<Header />

<main class="min-h-screen pt-36">
  <section class="relative py-16 md:py-24 bg-gradient-to-br from-[var(--color-bg-primary)] via-[var(--color-bg-secondary)] to-[var(--color-bg-primary)]">
    <div class="max-w-full mx-auto px-[clamp(16px,2vw,64px)]">
      <Breadcrumbs items={breadcrumbs} />
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
          {h1Before}<span class="gradient-text">{SITE_NAME}</span>{h1After}
        </h1>
        {doc.lead.map((paragraph, i) => (
          <p class:list={['text-xl text-[var(--color-text-secondary)] leading-relaxed', i < doc.lead.length - 1 ? 'mb-4' : '']}>
            {paragraph}
          </p>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-full mx-auto px-[clamp(16px,2vw,64px)]">
      <div class="max-w-3xl space-y-6 text-[var(--color-text-secondary)] text-lg leading-relaxed">
        {doc.body.map(paragraph => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="py-16 bg-[var(--color-bg-secondary)]">
    <div class="max-w-full mx-auto px-[clamp(16px,2vw,64px)]">
      <h2 class="section-title mb-12 text-center justify-center">{doc.featuresHeading}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {doc.features.map((feature, i) => (
          <div class="glass-card rounded-xl p-8 text-center">
            <div class="w-14 h-14 rounded-full bg-[var(--color-primary)]/10 flex items-center justify-center mx-auto mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[var(--color-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={FEATURE_ICONS[i]} />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3">{feature.title}</h3>
            <p class="text-[var(--color-text-secondary)]">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-full mx-auto px-[clamp(16px,2vw,64px)] text-center">
      <h2 class="section-title mb-6 justify-center">{doc.ctaHeading}</h2>
      <p class="text-[var(--color-text-secondary)] mb-8 max-w-xl mx-auto">{doc.ctaBody}</p>
      <a href={L('/contact/')} class="btn-primary">{doc.ctaButton}</a>
    </div>
  </section>

  <section class="py-8 border-t border-[var(--color-border)]">
    <div class="max-w-full mx-auto px-[clamp(16px,2vw,64px)]">
      <p class="text-xs text-[var(--color-text-muted)] text-center">{doc.footnote}</p>
    </div>
  </section>
</main>

<Footer />
