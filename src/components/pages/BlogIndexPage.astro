---
/**
 * BlogIndexPage.astro — the blog index in any locale.
 *
 * A localized index lists only the articles translated into that locale, so
 * every card leads to a page in the reader's language. The English index lists
 * everything, unchanged.
 */
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import SEOHead from '../SEOHead.astro';
import Schema from '../Schema.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { getAllBlogPosts } from '../../data/blogPosts';
import { getBlogImage } from '../../data/blogImages';
import { breadcrumbSchema } from '../../lib/schema';
import { SITE_URL } from '../../lib/seo';
import { loadTranslations, t } from '../../i18n';
import { getLocalizedPath } from '../../i18n/utils';
import { getLocalizedPost, translatedSlugs } from '../../i18n/blog';
import { DEFAULT_LANG, ROUTED_LANGS, type Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = await loadTranslations(lang);
const L = (path: string) => getLocalizedPath(path, lang);

const all = getAllBlogPosts();
const translated = new Set(translatedSlugs(lang));

/**
 * Each card carries its own locale's title and excerpt. On a localized index
 * only translated articles appear — an English teaser under a Hindi heading is
 * the exact failure this rewrite exists to avoid.
 */
const posts = (lang === DEFAULT_LANG ? all : all.filter(p => translated.has(p.slug))).map(post => {
  const local = lang === DEFAULT_LANG ? undefined : getLocalizedPost(lang, post.slug);
  return {
    slug: post.slug,
    title: local?.title ?? post.title,
    excerpt: local?.excerpt ?? post.excerpt,
    category: local?.category ?? post.category,
    readTime: local?.readTime ?? post.readTime,
    tags: local?.tags ?? post.tags,
    date: post.date,
    author: post.author,
    image: getBlogImage(post.slug, post.tags),
    href: L(`/blog/${post.slug}/`),
  };
});

const thumbnailUrl = (url: string) => url.replace('/t/p/w1280/', '/t/p/w500/');
const dateLocale = lang === DEFAULT_LANG ? 'en-US' : lang;
const shortDate = (iso: string) =>
  new Date(iso).toLocaleDateString(dateLocale, { month: 'short', day: 'numeric', year: 'numeric' });

const canonical = `${SITE_URL}${L('/blog/')}`;
const breadcrumbs = [
  { label: t(tr, 'nav.home'), href: L('/') },
  { label: t(tr, 'nav.blog'), href: L('/blog/') },
];

// Only locales that have at least one translated article; an index with nothing
// on it should not be advertised.
const localesWithPage = ROUTED_LANGS.filter(
  code => code !== DEFAULT_LANG && translatedSlugs(code).length > 0,
);
const featured = posts[0];
---

<SEOHead
  slot="head"
  title={t(tr, 'seo.blogTitle')}
  description={t(tr, 'blog.indexDescription')}
  canonical={canonical}
  localized={localesWithPage.length > 0}
  localesWithPage={localesWithPage}
/>
<Schema slot="head" schema={breadcrumbSchema(breadcrumbs)} />

<Header />

<main class="min-h-screen pt-36">
  <div class="max-w-full mx-auto px-[clamp(16px,2vw,64px)] py-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold mb-2">{t(tr, 'blog.title')}</h1>
      <p class="text-[var(--color-text-secondary)] text-sm md:text-base max-w-2xl">
        {t(tr, 'blog.indexLead')}
      </p>
    </div>

    {featured && (
      <a href={featured.href} class="block glass-card group rounded-xl overflow-hidden hover:border-[var(--color-primary)]/40 transition-all duration-300 mb-8">
        <div class="grid md:grid-cols-2 gap-0">
          <div class="aspect-[16/9] md:aspect-auto overflow-hidden">
            <img
              src={thumbnailUrl(featured.image.url)}
              alt={featured.image.alt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="eager"
              decoding="async"
              width="640"
              height="360"
              onerror="this.onerror=null;this.src='https://image.tmdb.org/t/p/w500/7RyHsO4yDXtBv1zUU3mTpHeQ0d5.jpg'"
            />
          </div>
          <div class="p-6 md:p-8 flex flex-col justify-center">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="text-[10px] px-2.5 py-1 rounded-full bg-[var(--color-primary)]/15 text-[var(--color-primary)] font-semibold uppercase tracking-wider">{featured.category}</span>
              <span class="text-[10px] text-[var(--color-text-muted)]">{featured.readTime}</span>
            </div>
            <h2 class="text-xl md:text-2xl font-bold mb-3 group-hover:text-[var(--color-primary)] transition-colors leading-tight">
              {featured.title}
            </h2>
            <p class="text-sm text-[var(--color-text-secondary)] mb-4 line-clamp-3">
              {featured.excerpt}
            </p>
            <div class="flex items-center gap-3 text-xs text-[var(--color-text-muted)]">
              <time>{shortDate(featured.date)}</time>
              <span>&middot;</span>
              <span>{featured.author}</span>
            </div>
          </div>
        </div>
      </a>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {posts.slice(1).map((post, i) => (
        <a href={post.href} class="glass-card group rounded-xl overflow-hidden hover:border-[var(--color-primary)]/40 transition-all duration-300 flex flex-col">
          <div class="aspect-[16/9] overflow-hidden">
            <img
              src={thumbnailUrl(post.image.url)}
              alt={post.image.alt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading={i < 3 ? 'eager' : 'lazy'}
              decoding="async"
              width="400"
              height="225"
              onerror="this.onerror=null;this.src='https://image.tmdb.org/t/p/w500/7RyHsO4yDXtBv1zUU3mTpHeQ0d5.jpg'"
            />
          </div>
          <div class="p-5 flex flex-col flex-1">
            <div class="flex flex-wrap items-center gap-2 mb-2.5">
              <span class="text-[9px] px-2 py-0.5 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] font-semibold uppercase tracking-wider">{post.category}</span>
              <span class="text-[10px] text-[var(--color-text-muted)]">{post.readTime}</span>
            </div>
            <h2 class="text-base font-bold mb-2 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2 leading-snug">
              {post.title}
            </h2>
            <p class="text-xs text-[var(--color-text-secondary)] line-clamp-2 mb-3 flex-1">
              {post.excerpt}
            </p>
            <div class="flex items-center justify-between text-[10px] text-[var(--color-text-muted)] pt-3 border-t border-[var(--color-border)]/50">
              <time>{shortDate(post.date)}</time>
              <div class="flex gap-1.5">
                {post.tags.slice(0, 2).map(tag => (
                  <span class="px-1.5 py-0.5 rounded bg-[var(--color-bg-card)] text-[var(--color-text-muted)] border border-[var(--color-border)]">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</main>

<Footer />
