---
import { generateSEO } from '../lib/seo';
import { getAlternateLinks, getLangFromUrl } from '../i18n/utils';
import { LANGUAGES, DEFAULT_LANG, type Lang } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  /**
   * Set when a page has localized equivalents. Emits a reciprocal hreflang
   * cluster and locale-aware Open Graph tags. Left off for pages that exist
   * only in English, since hreflang must not point at URLs that 404.
   */
  localized?: boolean;
  /**
   * Narrows the cluster to these locales. Blog articles are translated one at a
   * time, so an article's cluster must list only the locales that actually have
   * it — the default of every routed locale would advertise URLs that 404.
   * Ignored unless `localized` is set.
   */
  localesWithPage?: Lang[];
  /**
   * Dimensions of `ogImage`. The default is the site card; a page passing its
   * own image must pass its size with it, because a declared size that does not
   * match the file makes crawlers crop or skip the preview.
   */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Describes `ogImage`. Title pages name the title rather than the site. */
  ogImageAlt?: string;
}

const seo = generateSEO(Astro.props);

const ogImageAlt =
  Astro.props.ogImageAlt ??
  'NetMirror - Movies, TV Shows, Anime and Hindi Dubbed Discovery';
const ogImageWidth = Astro.props.ogImageWidth ?? 1200;
const ogImageHeight = Astro.props.ogImageHeight ?? 630;

// Facebook, X and WhatsApp only render raster previews, so the type has to be
// the truth about the file rather than a constant: TMDB serves JPEG, the site
// card is a PNG. Declaring the wrong one loses the preview.
const ogImageType = /\.jpe?g($|\?)/i.test(seo.ogImage) ? 'image/jpeg' : 'image/png';

const lang: Lang = getLangFromUrl(Astro.url);
// The cluster is built from the path, so every locale in it resolves to the
// same page rather than a homepage fallback.
const alternates = Astro.props.localized
  ? getAlternateLinks(Astro.url.pathname, Astro.props.localesWithPage)
  : [];

/** Open Graph wants a full locale, not a bare language code. */
const OG_LOCALES: Record<Lang, string> = {
  en: 'en_US', hi: 'hi_IN', ur: 'ur_PK', bn: 'bn_IN', es: 'es_ES', fr: 'fr_FR',
  de: 'de_DE', it: 'it_IT', pt: 'pt_BR', ru: 'ru_RU', ja: 'ja_JP', ko: 'ko_KR',
  ms: 'ms_MY', pl: 'pl_PL', id: 'id_ID', ar: 'ar_AR', bg: 'bg_BG', tr: 'tr_TR',
  sv: 'sv_SE',
};
const ogLocale = OG_LOCALES[lang] ?? 'en_US';
const otherOgLocales = Astro.props.localized
  ? (Object.keys(LANGUAGES) as Lang[]).filter(code => code !== lang).map(code => OG_LOCALES[code])
  : [];
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={seo.canonical} />

{/* Reciprocal hreflang. Each locale references itself and every equivalent,
    with x-default on the English URL, so the cluster validates. */}
{alternates.map(alt => (
  <link rel="alternate" hreflang={alt.lang} href={alt.href} />
))}

<!-- Open Graph -->
<meta property="og:title" content={seo.ogTitle} />
<meta property="og:description" content={seo.ogDescription} />
<meta property="og:image" content={seo.ogImage} />
<meta property="og:image:secure_url" content={seo.ogImage} />
<meta property="og:image:type" content={ogImageType} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:type" content={seo.ogType} />
<meta property="og:site_name" content="NetMirror" />
<meta property="og:locale" content={ogLocale} />
{otherOgLocales.map(code => <meta property="og:locale:alternate" content={code} />)}

<!-- Twitter Card -->
<meta name="twitter:card" content={seo.twitterCard} />
<meta name="twitter:title" content={seo.ogTitle} />
<meta name="twitter:description" content={seo.ogDescription} />
<meta name="twitter:image" content={seo.ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{/* follow, not nofollow: these pages should stay out of the index while still
    passing crawlers through to the catalogue they link to. */}
{seo.noindex && <meta name="robots" content="noindex, follow" />}

<!-- PWA / Web App -->
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#e51d4c" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Net27" />
<link rel="apple-touch-icon" href="/favicon.svg" />
