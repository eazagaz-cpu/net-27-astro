---
/**
 * English blog article. The body lives in BlogPostPage so this route and its
 * localized twins cannot drift apart.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostPage from '../../components/pages/BlogPostPage.astro';
import { blogPosts } from '../../data/blogPosts';
import { DEFAULT_LANG } from '../../i18n/config';

export const getStaticPaths = (() => {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
---

<BaseLayout>
  <BlogPostPage post={post} lang={DEFAULT_LANG} />
</BaseLayout>
