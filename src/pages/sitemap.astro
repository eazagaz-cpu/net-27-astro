---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import Schema from '../components/Schema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbSchema } from '../lib/schema';
import { SITE_URL } from '../lib/seo';
import { SITE_NAME } from '../lib/constants';
import { getAllRealTitles } from '../lib/realTitles';

const allTitles = getAllRealTitles();
const movieTitles = allTitles.filter(title => title.type === 'movie');
const showTitles = allTitles.filter(title => title.type === 'show');
const archivePageSize = 30;
const archiveLinks = [
  { label: 'Movie directory', section: 'movies', count: movieTitles.length },
  { label: 'TV show directory', section: 'shows', count: showTitles.length },
].flatMap(group => Array.from(
  { length: Math.ceil(group.count / archivePageSize) },
  (_, index) => ({
    label: `${group.label} — page ${index + 1}`,
    href: `/sitemap/${group.section}/${index + 1}/`,
  }),
));
const hubLinks = [
  { label: 'Home', href: '/' },
  { label: 'Movies', href: '/movies/' },
  { label: 'TV Shows', href: '/shows/' },
  { label: 'Anime', href: '/anime/' },
  { label: 'Trending', href: '/trending/' },
  { label: 'Latest Releases', href: '/latest/' },
  { label: 'Search', href: '/search/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Download App', href: '/app/download/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Sitemap', href: '/sitemap/' },
];

const sitemapSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `Sitemap | ${SITE_NAME}`,
  description: `Browse all ${SITE_NAME} pages — movies, TV shows, anime, app downloads, help guides, platforms, genres, blog articles, and legal pages.`,
  url: `${SITE_URL}/sitemap/`,
};
---

<BaseLayout>
  <SEOHead
    slot="head"
    title={`Sitemap — ${SITE_NAME}`}
    description={`Browse all important ${SITE_NAME} pages, including movies, TV shows, anime, app download pages, help guides, platform pages, genre pages, blog articles, legal pages, and language versions.`}
    canonical={`${SITE_URL}/sitemap/`}
  />
  <Schema slot="head" schema={[breadcrumbSchema(breadcrumbs), sitemapSchema]} />

  <Header />

  <main class="min-h-screen pt-36">
    <div class="max-w-6xl mx-auto px-4 py-8">
      <Breadcrumbs items={breadcrumbs} />

      <h1 class="text-3xl md:text-4xl font-bold mb-3">Sitemap</h1>
      <p class="text-sm text-[var(--color-text-secondary)] mb-10 max-w-2xl">
        Browse all {SITE_NAME} pages — movies, TV shows, anime, app downloads, help guides, streaming platforms, genres, blog articles, and legal information.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        <section class="glass-card rounded-xl p-5">
          <h2 class="text-lg font-bold mb-4">Main directories</h2>
          <ul class="space-y-2">
            {hubLinks.map(link => (
              <li><a href={link.href} class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-primary)]">{link.label}</a></li>
            ))}
          </ul>
        </section>
        <section class="glass-card rounded-xl p-5">
          <h2 class="text-lg font-bold mb-4">Title directories</h2>
          <p class="text-xs text-[var(--color-text-muted)] mb-4">Every generated movie and TV page is linked in crawlable batches of 30.</p>
          <ul class="space-y-2">
            {archiveLinks.map(link => (
              <li><a href={link.href} class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-primary)]">{link.label}</a></li>
            ))}
          </ul>
        </section>
      </div>

      <!-- Disclaimer -->
      <div class="border-t border-white/5 pt-6">
        <p class="text-[10px] text-[var(--color-text-muted)] text-center leading-relaxed max-w-2xl mx-auto">
          {SITE_NAME} does not host, store, or distribute any media content. All information is for discovery purposes only. All trademarks belong to their respective owners.
        </p>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
