---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SEOHead from '../../components/SEOHead.astro';
import Schema from '../../components/Schema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { SITE_URL } from '../../lib/seo';

const currentYear = new Date().getFullYear();
const years = [2026, 2025, 2024, 2023];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'New Releases', href: '/new/' },
];
---

<BaseLayout>
  <SEOHead
    slot="head"
    title="New Releases by Year — Movies & Shows | Net27"
    description="Browse the best movies, TV shows, and anime by release year. From 2023 to 2026 — discover what's new and find where to stream them."
    canonical={`${SITE_URL}/new/`}
    localized={true}
  />
  <Schema slot="head" schema={breadcrumbSchema(breadcrumbs)} />

  <Header />

  <main class="min-h-screen">
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-primary)]/10 to-[var(--color-accent)]/10"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg-primary)] to-transparent"></div>
      <div class="relative z-10 mx-auto max-w-full px-[clamp(16px,2vw,64px)] pt-28 pb-10">
        <Breadcrumbs items={breadcrumbs} />
        <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold leading-tight">
          🆕 New Releases <span class="gradient-text">by Year</span>
        </h1>
        <p class="mt-3 text-[var(--color-text-secondary)] text-lg max-w-2xl">
          Explore the best movies, shows, and anime from every year — find where to stream them instantly.
        </p>
      </div>
    </section>

    <div class="mx-auto max-w-full px-[clamp(16px,2vw,64px)] py-10">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
        {years.map(year => (
          <a
            href={`/new/${year}/`}
            class="glass-card rounded-2xl p-8 flex flex-col items-center text-center hover:border-[var(--color-primary)]/40 transition-all group no-underline bg-gradient-to-br from-[var(--color-primary)]/5 to-[var(--color-accent)]/5"
          >
            <span class="text-5xl font-extrabold gradient-text group-hover:scale-105 transition-transform">{year}</span>
            <span class="mt-3 text-sm text-[var(--color-text-muted)]">
              {year === currentYear ? '🔥 Latest releases' : `Best of ${year}`}
            </span>
            <span class="mt-4 chip text-xs">Browse →</span>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
