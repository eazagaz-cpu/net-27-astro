---
/**
 * English TV show pages. The body lives in ShowPage so this route and
 * its localized twin cannot drift apart.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShowPage from '../../components/pages/ShowPage.astro';
import { getRealTitlesByType } from '../../lib/realTitles';
import { DEFAULT_LANG } from '../../i18n/config';

export const getStaticPaths = (() => {
  return getRealTitlesByType('show').map(title => ({
    params: { slug: title.slug },
    props: { title },
  }));
}) satisfies GetStaticPaths;

const { title } = Astro.props;
---

<BaseLayout>
  <ShowPage title={title} lang={DEFAULT_LANG} />
</BaseLayout>
