---
/**
 * Localized TV show pages, one per non-default locale. English keeps its
 * existing unprefixed URLs.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShowPage from '../../../components/pages/ShowPage.astro';
import { getRealTitlesByType, type RealTitle } from '../../../lib/realTitles';
import { ROUTED_LANGS, DEFAULT_LANG, type Lang } from '../../../i18n/config';

export const getStaticPaths = (() => {
  const titles = getRealTitlesByType('show');
  return ROUTED_LANGS
    .filter(code => code !== DEFAULT_LANG)
    .flatMap(lang => titles.map(title => ({
      params: { lang, slug: title.slug },
      props: { title, lang },
    })));
}) satisfies GetStaticPaths;

const { title, lang } = Astro.props as { title: RealTitle; lang: Lang };
---

<BaseLayout>
  <ShowPage title={title} lang={lang} />
</BaseLayout>
