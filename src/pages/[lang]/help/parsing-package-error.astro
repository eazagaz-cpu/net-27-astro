---
/**
 * Localized help/parsing-package-error pages, one per non-default routed locale. English keeps its
 * existing unprefixed URL.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HelpPage from '../../../components/pages/HelpPage.astro';
import { ROUTED_LANGS, DEFAULT_LANG, type Lang } from '../../../i18n/config';
import { TRANSLATED_HELP_LANGS } from '../../../i18n/static/help';

export const getStaticPaths = (() => {
  // Only locales that actually have this page translated. A locale added to
  // ROUTED_LANGS gets the catalogue in its own language immediately; this page
  // waits until its prose exists, rather than serving English under its URL.
  return ROUTED_LANGS
    .filter(code => code !== DEFAULT_LANG && TRANSLATED_HELP_LANGS.includes(code))
    .map(lang => ({ params: { lang }, props: { lang } }));
}) satisfies GetStaticPaths;

const { lang } = Astro.props as { lang: Lang };
---

<BaseLayout>
  <HelpPage doc="parsingPackageError" lang={lang} />
</BaseLayout>
