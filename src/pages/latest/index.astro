---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withTitleSlugs } from '../../lib/gridItems';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SEOHead from '../../components/SEOHead.astro';
import Schema from '../../components/Schema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DynamicGrid from '../../components/DynamicGrid.tsx';
import { breadcrumbSchema } from '../../lib/schema';
import { SITE_URL } from '../../lib/seo';
import latestMovies from '../../data/cache/latest-movies.json';
import latestTv from '../../data/cache/latest-tv.json';

// Combine movies + TV, sort by release date (newest first), deduplicate
const combined = [...(latestMovies.items || []), ...(latestTv.items || [])];
const seen = new Set<number>();
const latestItems = combined
  .filter(item => { if (seen.has(item.id)) return false; seen.add(item.id); return true; })
  .sort((a: any, b: any) => (b.release_date || '').localeCompare(a.release_date || ''))
  .slice(0, 60); // Top 60 latest

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Latest Releases', href: '/latest/' },
];
---

<BaseLayout>
  <SEOHead slot="head" title="Latest Releases — New Movies & Shows Today" description="Discover the newest movies and TV shows. Fresh titles added daily across Netflix, Prime Video, Disney+ and more streaming platforms." canonical={`${SITE_URL}/latest/`} localized={true} />
  <Schema slot="head" schema={breadcrumbSchema(breadcrumbs)} />
  <Header />
  <main class="min-h-screen pt-36">
    <div class="max-w-full mx-auto px-[clamp(16px,2vw,64px)] py-8">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="text-3xl md:text-4xl font-bold mb-2">🆕 Latest Releases</h1>
      <p class="text-[var(--color-muted)] mb-8">Newest movies and TV shows released across all streaming platforms.</p>
      <DynamicGrid client:idle category="latest" title="Latest Releases" initialItems={withTitleSlugs(latestItems)} />
    </div>
  </main>
  <Footer />
</BaseLayout>
