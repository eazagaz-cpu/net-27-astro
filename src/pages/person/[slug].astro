---
/**
 * English actor and director pages. The body lives in PersonPage so this route
 * and its localized twin cannot drift apart.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonPage from '../../components/pages/PersonPage.astro';
import { getAllPeople } from '../../lib/people';
import { DEFAULT_LANG } from '../../i18n/config';

export const getStaticPaths = (() => {
  return getAllPeople().map(person => ({
    params: { slug: person.slug },
    props: { person },
  }));
}) satisfies GetStaticPaths;

const { person } = Astro.props;
---

<BaseLayout>
  <PersonPage person={person} lang={DEFAULT_LANG} />
</BaseLayout>
