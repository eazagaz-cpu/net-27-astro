---
/**
 * English movie pages. The body lives in MoviePage so this route and
 * its localized twin cannot drift apart.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MoviePage from '../../components/pages/MoviePage.astro';
import { getRealTitlesByType } from '../../lib/realTitles';
import { DEFAULT_LANG } from '../../i18n/config';

export const getStaticPaths = (() => {
  return getRealTitlesByType('movie').map(title => ({
    params: { slug: title.slug },
    props: { title },
  }));
}) satisfies GetStaticPaths;

const { title } = Astro.props;
---

<BaseLayout>
  <MoviePage title={title} lang={DEFAULT_LANG} />
</BaseLayout>
