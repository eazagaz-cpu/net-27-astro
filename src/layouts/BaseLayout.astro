---
import '../styles/global.css';
import { getLangFromUrl, getDir, stripLangFromPath } from '../i18n/utils';
import PopAd from '../components/PopAd.astro';
import SearchOverlay from '../components/SearchOverlay.tsx';

const lang = getLangFromUrl(Astro.url);
const dir = getDir(lang);

/**
 * Pages the popunder is kept off.
 *
 * Not a policy hedge — a popunder pays on the click that opens it, so it earns
 * nothing on a page nobody clicks through. These are the pages where it would
 * only cost goodwill: the legal and compliance documents, the contact form, and
 * the signed-in surfaces, which are noindex and carry no search traffic anyway.
 *
 * Matching is on the language-stripped path, so a locale prefix cannot smuggle
 * a legal page past the list.
 */
const POP_AD_EXCLUDED = [
  '/privacy/', '/terms/', '/disclaimer/', '/dmca/', '/editorial/',
  '/contact/', '/about/', '/login/', '/watchlist/',
];
const barePath = stripLangFromPath(Astro.url.pathname);
const showPopAd = !POP_AD_EXCLUDED.includes(barePath);
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#050509" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://image.tmdb.org" />
  <link rel="dns-prefetch" href="https://www.2embed.cc" />
  <link rel="dns-prefetch" href="https://autoembed.co" />
  <!-- hreflang is emitted by SEOHead for pages that have localized routes,
       where the cluster resolves to a real equivalent. Pages without one omit
       it rather than pointing at URLs that would 404. -->
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <!-- Bing Webmaster Tools site verification. Must stay even after verifying —
       Bing rechecks it and un-verifies the site if it disappears. -->
  <meta name="msvalidate.01" content="E9FCACCA5615048272A04444381445CF" />
  <!-- Yandex site verification. Preferred over the HTML-file method here:
       Cloudflare Pages 308-redirects away the .html extension and injects a
       script into HTML bodies, so the file never matches exactly. -->
  <meta name="yandex-verification" content="c9591467b7b65148" />
  <!-- ProfitON domain verification. Tag method rather than the txt file, for the
       same Cloudflare Pages reason as Yandex above. Must stay after verifying. -->
  <meta name="profiton-domain-verification" content="40186f11d9a1befb7ed17486cac0f9806604e5e13e242d6ad1bdbad050106ef5" />
  <!-- Google AdSense. Loads on every page because AdSense verifies ownership
       and reviews the site by finding this tag, not just on the home page. -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4341205984811312" crossorigin="anonymous" is:inline></script>
  <slot name="head" />
  <!-- Analytics is loaded after real user intent, keeping third-party code out of the critical path. -->
  <script is:inline>
    (function(){
      var loaded=false;
      function loadAnalytics(){
        if(loaded)return;
        loaded=true;
        window.dataLayer=window.dataLayer||[];
        window.gtag=function(){window.dataLayer.push(arguments);};
        window.gtag('js',new Date());
        window.gtag('config','G-BEV78WNW13',{transport_type:'beacon'});
        var s=document.createElement('script');
        s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=G-BEV78WNW13';
        document.head.appendChild(s);
      }
      ['pointerdown','keydown','touchstart'].forEach(function(event){
        window.addEventListener(event,loadAnalytics,{once:true,passive:true});
      });
    })();
  </script>
  <!-- Service Worker registration — deferred until after first interaction -->
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/sw.js', { scope: '/' })
          .catch(function() {}); // Silently fail — SW is enhancement only
      });
    }
  </script>
</head>
<body class="min-h-screen bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] antialiased">
  <SearchOverlay client:media="(min-width: 768px)" />
  <slot />
  <!-- i18n Client Translation Engine -->
  <script is:inline>
  (function(){
    var KEY='netmirror_lang';
    var lang=localStorage.getItem(KEY)||'en';
    if(lang==='en')return;
    fetch('/locales/'+lang+'.json').then(function(r){return r.json()}).then(function(data){
      document.documentElement.setAttribute('lang',lang);
      if(lang==='ar'||lang==='ur')document.documentElement.setAttribute('dir','rtl');
      translatePage(data);
      // Expose translation helpers for React components (must be inside .then — data is only defined here)
      window.__nmT=function(key){return get(data,key);};
      window.__nmLocale=data;
      document.dispatchEvent(new CustomEvent('nm:locale:ready',{detail:data}));
    }).catch(function(){});

    function get(obj,path){
      var keys=path.split('.');
      var v=obj;
      for(var i=0;i<keys.length;i++){v=v&&v[keys[i]];}
      return typeof v==='string'?v:null;
    }

    function translatePage(t){
      // Update browser tab title based on current page
      var p=location.pathname;
      var titleMap={
        '/':'seo.homeTitle',
        '/movies/':'seo.moviesTitle',
        '/shows/':'seo.showsTitle',
        '/anime/':'seo.animeTitle',
        '/trending/':'seo.trendingTitle',
        '/latest/':'seo.latestTitle',
        '/blog/':'seo.blogTitle',
        '/search/':'seo.searchTitle',
        '/login/':'seo.loginTitle',
        '/player/':'seo.playerTitle'
      };
      var titleKey=titleMap[p];
      if(titleKey){
        var newTitle=get(t,titleKey);
        if(newTitle)document.title=newTitle;
      }

      // Synopsis: the page ships whatever translations TMDB had for this title,
      // so swapping is a local lookup rather than another request. Falls through
      // to the English text when this language is not among them.
      var ovs=document.querySelectorAll('[data-i18n-overview]');
      for(var o=0;o<ovs.length;o++){
        try{
          var map=JSON.parse(ovs[o].getAttribute('data-i18n-overview'));
          if(map&&map[lang])ovs[o].textContent=map[lang];
        }catch(e){}
      }

      // data-t attribute based
      var els=document.querySelectorAll('[data-t]');
      for(var i=0;i<els.length;i++){
        var val=get(t,els[i].getAttribute('data-t'));
        if(val){
          if(els[i].tagName==='INPUT'||els[i].tagName==='TEXTAREA'){
            els[i].setAttribute('placeholder',val);
          } else {
            els[i].textContent=val;
          }
        }
      }

      // Nav links
      tByText('Home',get(t,'nav.home'));
      tByText('Movies',get(t,'nav.movies'));
      tByText('TV Shows',get(t,'nav.tvShows'));
      tByText('Anime',get(t,'nav.anime'));
      tByText('Trending',get(t,'nav.trending'));
      tByText('Latest',get(t,'nav.latest'));
      tByText('Blog',get(t,'nav.blog'));
      tByText('Sign In',get(t,'nav.signIn'));

      // Common buttons
      tByText('Watch Now',get(t,'common.watchNow'));
      tByText('More Info',get(t,'common.moreInfo'));
      tByText('View All →',get(t,'common.viewAll')+' →');
      tByText('Get the app',get(t,'common.getTheApp'));
      tByText('Phone',get(t,'common.phone'));

      // Footer headings
      tByText('QUICK LINKS',get(t,'footer.quickLinks'));
      tByText('PLATFORMS',get(t,'footer.platforms'));
      tByText('GENRES',get(t,'footer.genres'));
      tByText('LEGAL',get(t,'footer.legal'));
      tByText('FOLLOW US',get(t,'footer.followUs'));
      tByText('About',get(t,'footer.about'));
      tByText('Contact',get(t,'footer.contact'));
      tByText('Privacy Policy',get(t,'footer.privacyPolicy'));
      tByText('Terms of Service',get(t,'footer.termsOfService'));
      tByText('Editorial Policy',get(t,'footer.editorialPolicy'));
      tByText('DMCA Policy',get(t,'footer.dmcaPolicy'));
      tByText('Disclaimer',get(t,'footer.disclaimerPage'));

      // Search placeholder
      var searchInputs=document.querySelectorAll('input[type="email"],input[placeholder*="Search"],input[placeholder*="search"]');
      var sp=get(t,'search.placeholder');
      if(sp){for(var j=0;j<searchInputs.length;j++){
        if(searchInputs[j].placeholder.toLowerCase().indexOf('search')!==-1)searchInputs[j].placeholder=sp;
      }}

      // Hero label
      tByText('Trending Now',get(t,'common.trendingNow'));
      tByText('TRENDING NOW',get(t,'common.trendingNow'));

      // Announcement tips
      var tips=document.querySelectorAll('.announcement-item');
      var tipKeys=['announcement.tip1','announcement.tip2','announcement.tip3','announcement.tip4','announcement.tip5'];
      for(var k=0;k<tips.length&&k<tipKeys.length;k++){
        var tv=get(t,tipKeys[k]);
        if(tv)tips[k].textContent=tv;
      }

      // Section titles with text matching
      tByText('Frequently Asked Questions',get(t,'blog.faqs'));

      // Rail titles
      tByText('Trending Now',get(t,'rails.trendingNow'));
      tByText('Latest Releases (2025–2026)',get(t,'rails.latestReleases'));
      tByText('New in 2026',get(t,'rails.new2026'));
      tByText('Popular on Netflix',get(t,'rails.netflix'));
      tByText('Action Movies',get(t,'rails.action'));
      tByText('Drama Series',get(t,'rails.drama'));
      tByText('Comedy',get(t,'rails.comedy'));
      tByText('Thrillers',get(t,'rails.thriller'));
      tByText('Romance',get(t,'rails.romance'));
      tByText('Horror',get(t,'rails.horror'));
      tByText('Animation & Family',get(t,'rails.animationFamily'));
      tByText('Trending Globally — Coming Soon',get(t,'rails.comingSoon'));
      tByText('Hindi Dubbed Hits',get(t,'rails.hindiDubbed'));
    }

    function tByText(original,translated){
      if(!translated||!original)return;
      var walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT,null,false);
      while(walker.nextNode()){
        var node=walker.currentNode;
        if(node.nodeValue.trim()===original){
          node.nodeValue=translated;
        }
      }
    }
  })();
  </script>

  {showPopAd && <PopAd />}
</body>
</html>
