{
  "name": "net-27.cc",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "sync": "node src/scripts/movie-sync.mjs",
    "prebuild": "node scripts/verify-links.mjs && node src/scripts/movie-sync.mjs",
    "build": "astro build",
    "postbuild": "node scripts/verify-dist-links.mjs",
    "ping": "node scripts/ping-sitemaps.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "auth:check": "node scripts/preflight-auth.mjs",
    "cf": "node scripts/wrangler.mjs",
    "cf:login": "node scripts/wrangler.mjs auth create net27",
    "cf:check": "node scripts/preflight-auth.mjs",
    "cf:deploy": "npm run auth:check && astro build && node scripts/verify-dist-links.mjs && node scripts/wrangler.mjs pages deploy ./dist --project-name net-27-astro --branch main --commit-dirty=true",
    "build:fast": "cross-env SKIP_SYNC=1 astro build",
    "sponsors:images": "node scripts/convert-sponsor-images.mjs",
    "deploy:fast": "npm run auth:check && cross-env SKIP_SYNC=1 astro build && node scripts/verify-dist-links.mjs && node scripts/wrangler.mjs pages deploy ./dist --project-name net-27-astro --branch main --commit-dirty=true",
    "index:now": "node scripts/instant-index.mjs",
    "index:all": "node scripts/instant-index.mjs all",
    "index:blog": "node scripts/instant-index.mjs blog",
    "sponsors:push": "npm run auth:check && node scripts/push-sponsors.mjs",
    "sponsors:add": "node scripts/add-sponsor.mjs",
    "sponsors:remove": "node scripts/remove-sponsor.mjs",
    "sponsors:rebuild": "node scripts/_build_hardcoded_sponsors.mjs",
    "sponsors:deploy": "npm run auth:check && node scripts/verify-links.mjs && node scripts/push-sponsors.mjs --no-kv && node scripts/safe-push.mjs \"chore(sponsors): update sponsor links\" && node scripts/push-sponsors.mjs",
    "push:safe": "npm run auth:check && node scripts/safe-push.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "deploy:safe": "npm run sponsors:deploy",
    "test:sponsors": "node tests/sponsor-persistence.test.mjs",
    "validate:api": "node scripts/validate-api-config.mjs",
    "validate:media": "node scripts/validate-media.mjs",
    "validate:routes": "node scripts/validate-routes.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "validate:performance": "node scripts/validate-performance.mjs",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "validate:sitemap": "node scripts/validate-sitemap.mjs",
    "validate:indexing": "node scripts/validate-sitemap.mjs",
    "validate:html-sitemap": "node scripts/validate-html-sitemap.mjs",
    "validate:og": "node scripts/validate-og.mjs",
    "validate:blog-i18n": "node scripts/validate-blog-i18n.mjs",
    "validate:csp": "node scripts/validate-csp.mjs",
    "validate:locales": "node scripts/validate-locales.mjs",
    "verify:dist": "node scripts/verify-dist-links.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.3.0",
    "@movie-web/providers": "^2.4.13",
    "astro": "^5.7.0",
    "firebase": "^12.15.0",
    "hls.js": "^1.6.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.1",
    "wrangler": "4.120.1"
  }
}
